{
  "$schema": "./schema.md",
  "configVersion": 1,
  "configured": true,

  "language": "ru",

  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },

  "safe": {
    "top": 290,
    "bottom": 320,
    "pagePad": 90
  },

  "subtitles": {
    "mode": "own",
    "look": "white",
    "position": 0.08,
    "chunk": "page",
    "size": 0.58,
    "plate": true,
    "highlight": true,
    "accent": "#245CFF"
  },

  "sfx": {
    "enabled": true,
    "volume": 1.0,
    "seams": true
  },

  "music": {
    "enabled": true,
    "track": "auto",
    "volume": 0.15,
    "fadeIn": 1.5,
    "fadeOut": 2.5
  },

  "style": {
    "path": "./style"
  },

  "voice": {
    "elevenlabs": {
      "enabled": false,
      "voiceId": "",
      "modelId": "eleven_multilingual_v2",
      "stability": 0.4,
      "similarityBoost": 0.75,
      "speed": 1.0
    }
  },

  "avatar": {
    "provider": "none",
    "avatarId": "",
    "placement": "corner",
    "size": 0.32
  },

  "transcribe": {
    "engine": "gigaam",
    "models": "models",
    "quantization": "",
    "language": "ru"
  },

  "cleanup": {
    "enabled": true,
    "silenceThresholdDb": -45,
    "minSilenceSec": 1.0,
    "keepPadSec": 0.25,
    "cutFillers": true,
    "cutRepeats": true,
    "voicePolish": true,
    "fillers": ["ээ", "эээ", "ммм", "эм", "а-а", "а-а-а", "э-э", "м-м"],
    "videoCutStyle": "none"
  },

  "shots": {
    "enabled": true,
    "web": true,
    "chromePath": "",
    "maxPerReel": 4,
    "waitMs": 15000,
    "parallel": 6,
    "viewport": { "width": 1440, "height": 900, "scale": 2 }
  },

  "animator": {
    "enabled": true,
    "path": "tools/Animator"
  },

  "effectcraft": { "cli": "" },
  "filmcraft": { "cli": "", "exportOnRender": true },

  "blender": {
    "enabled": true,
    "executable": "tools/blender/blender",
    "engine": "CYCLES",
    "samples": 16,
    "threads": 4
  },

  "footage": {
    "enabled": true,
    "youtube": true,
    "creativeCommonsOnly": true,
    "pexels": true,
    "candidates": 4,
    "previewSeconds": 150,
    "maxSlowdown": 1.5,
    "minScore": 0.24
  },

  "render": {
    "crf": 18,
    "concurrency": 2,
    "loudness": {
      "normalize": true,
      "targetLufs": -13,
      "truePeak": -1
    }
  }
}
