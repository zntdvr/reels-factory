GEMINI_API_KEY=
# optional: override the default text model
# GEMINI_MODEL=

# web API (python -m animator.api)
# Supabase project settings -> API keys. Use the SECRET key here (server only, never in the frontend).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# comma-separated frontend origins allowed to call the API
API_ALLOWED_ORIGINS=http://localhost:5173

# --- OpenRouter backend (python -m animator --provider openrouter) ---
# ANIMATOR_PROVIDER=openrouter
# Reels Factory's --spec integration uses OpenRouter for generated boards.
OPENROUTER_API_KEY=
# optional overrides (defaults shown)
# OPENROUTER_TEXT_MODEL=claude-code:sonnet   # local claude CLI; or an OpenRouter id, e.g. anthropic/claude-sonnet-5.5
# OPENROUTER_REGION_MODEL=google/gemini-3.8-flash
# OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash   # $0.007/img; alt: bytedance-seed/seedream-5-0-flash, google/gemini-3.1-flash-lite-image
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
# OPENROUTER_VOICE=Charon
# OPENROUTER_TTS_INSTRUCTIONS=Спокойный уверенный голос эксперта, умеренный темп
# OPENROUTER_IMAGE_ASPECT=16:9
# HTTPS_PROXY=http://user:pass@host:port
